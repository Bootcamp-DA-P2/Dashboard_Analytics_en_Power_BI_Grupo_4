{
  "name": "Light Mocha & Lilac",
  "background": "#F5F0EB",
  "foreground": "#4E342E",
  "tableAccent": "#957DAD",
  "good": "#81C784",
  "neutral": "#A1887F",
  "bad": "#E57373",
  "maximum": "#5D4037",
  "center": "#D7CCC8",
  "minimum": "#EFEBE9",
  "dataColors": [
    "#5D4037",
    "#957DAD",
    "#8D6E63",
    "#BCAAA4",
    "#D7CCC8",
    "#7B6896",
    "#A1887F",
    "#4E342E"
  ],
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F5F0EB" } },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 65
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#957DAD" } },
            "radius": 8,
            "transparency": 75,
            "width": 1
          }
        ],
        "shadow": [
          {
            "show": true,
            "position": "Outer",
            "color": { "solid": { "color": "#957DAD" } },
            "transparency": 90,
            "blur": 18,
            "angle": 45,
            "distance": 5
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#3E2723" } },
            "background": { "solid": { "color": "#EFEBE9" } },
            "transparency": 50,
            "fontSize": 16,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "Left"
          }
        ],
        "label": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#4E342E" } },
            "fontSize": 11
          }
        ]
      }
    },
    "card": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 55
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#7B6896" } },
            "radius": 10,
            "width": 1,
            "transparency": 60
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#3E2723" } },
            "background": { "solid": { "color": "#E1D5E7" } },
            "transparency": 60,
            "fontSize": 18,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "title": [
          {
            "show": true,
            "fontSize": 18,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": { "solid": { "color": "#3E2723" } }
          }
        ]
      }
    }
  }
}        